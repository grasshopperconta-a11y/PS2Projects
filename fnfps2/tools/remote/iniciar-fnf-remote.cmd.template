@echo off
chcp 65001 >nul
setlocal

rem ============================================================
rem  FNF REMOTE - iniciar
rem ============================================================
rem  De dois cliques neste arquivo. Ele:
rem    1. configura o endereco da ponte e a senha
rem    2. abre o cliente PowerShell
rem    3. se o cliente fechar ou der erro, ESPERA 3s e ABRE DE NOVO
rem
rem  Ou seja: fechar e reabrir volta a funcionar igual. Se quiser
rem  parar de vez, feche esta janela.
rem ============================================================

set "FNF_PONTE=@@PONTE@@"
set "FNF_TOKEN=@@TOKEN@@"

rem ------------------------------------------------------------
rem  Validacao: o endereco tem de comecar com http. Um arquivo gerado
rem  errado eh pego aqui, e nao na hora de conectar.
rem  (A senha eh validada pelo PowerShell, que sabe contar caracteres
rem  direito -- contar em batch da margem a erro.)
rem ------------------------------------------------------------
echo %FNF_PONTE% | findstr /b /c:"http" >nul
if errorlevel 1 (
    echo ERRO: endereco da ponte nao parece valido: %FNF_PONTE%
    echo Peca um novo "iniciar-fnf-remote.cmd" -- este aqui nao foi gerado direito.
    pause
    exit /b 2
)

echo.
echo   FNF REMOTE iniciando...
echo   ponte: %FNF_PONTE%
echo.
echo   Deixe esta janela ABERTA. Feche-a so quando quiser parar.
echo   Se o cliente fechar sozinho, ele reabre em 3 segundos.
echo.

:loop
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0fnf-remote-client.ps1"
echo.
echo   [ %TIME% ] cliente encerrou. reabrindo em 3 segundos...
timeout /t 3 /nobreak >nul
goto loop
